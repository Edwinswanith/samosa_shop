{
  "name": "samosa-shop-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file=.env.local scripts/setup-mongodb.ts",
    "db:import-sales": "node --env-file=.env.local scripts/import-sales.ts",
    "db:import-operations": "node --env-file=.env.local scripts/import-operations.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "latest",
    "@fontsource/manrope": "latest",
    "decimal.js": "latest",
    "lucide-react": "latest",
    "mongodb": "latest",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.3",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "4.1.11"
  }
}
